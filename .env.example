# Copy to .env and fill in your SendGrid API key.
# Required for quote form email delivery.

SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=info.estalandscaping@gmail.com
QUOTE_NOTIFICATION_EMAIL=info.estalandscaping@gmail.com

# Optional: send automatic confirmation email to the customer after they submit a quote.
# SENDGRID_SEND_CONFIRMATION=true
