# Copy to .env (local) or set in Vercel Environment Variables.

# --- Gmail API (OAuth2) — /api/contact sends to info@estalandscaping.com ---
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=https://estalandscaping.com/callback
GMAIL_REFRESH_TOKEN=to_be_added

# --- SendGrid (optional fallback /api/quote) ---
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=info.estalandscaping@gmail.com
# QUOTE_NOTIFICATION_EMAIL=info.estalandscaping@gmail.com
# SENDGRID_SEND_CONFIRMATION=true
