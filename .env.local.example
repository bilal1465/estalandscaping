# Copy to .env.local (local dev) or set in Vercel → Settings → Environment Variables.
# Gmail API (OAuth2) — used by /api/contact to send inquiries to info@estalandscaping.com

GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=https://estalandscaping.com/callback
GMAIL_REFRESH_TOKEN=to_be_added

# Get GMAIL_REFRESH_TOKEN via OAuth 2.0 Playground — see GMAIL_SETUP.md
